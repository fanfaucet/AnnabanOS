# Local development only. Never commit real credentials.
# Store-scoped Printful API token; required only for live API calls.
PRINTFUL_STORE_TOKEN=

# Shopify Admin API token for a separate, future listing integration.
# Not used by the mock-up-only prototype.
SHOPIFY_ACCESS_TOKEN=

# Optional: v2 Printful API base URL. Keep HTTPS.
PRINTFUL_API_BASE=https://api.printful.com
